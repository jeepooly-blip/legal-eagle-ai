# =============================================================================
# Legal Eagle AI - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# =============================================================================

# ---- LLM (MiniMax via LiteLLM) ---------------------------------------------
# Set the model identifier exactly as LiteLLM expects it.
# Examples:
#   MINIMAX_MODEL=minimax/minimax-M3
#   MINIMAX_MODEL=openai/gpt-4o-mini          (fallback)
MINIMAX_MODEL=minimax/minimax-M3
MINIMAX_API_KEY=sk-replace-me
MINIMAX_BASE_URL=https://integrate.api.Nexa.com/v1

# ---- CourtListener (US) -----------------------------------------------------
# Public API. Token optional but raises the rate limit.
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4
COURTLISTENER_API_TOKEN=

# ---- EUR-Lex (EU) -----------------------------------------------------------
# Public SPARQL/Cellar endpoints. No key required.
EURLEX_BASE_URL=https://eur-lex.europa.eu
EURLEX_SPARQL_ENDPOINT=https://publications.europa.eu/webapi/rdf/sparql

# ---- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-me

# ---- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=900
RATE_LIMIT_RPM=30
